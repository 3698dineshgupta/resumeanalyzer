# ─── Backend Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values

# MongoDB connection string
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=resume_analyzer

# JWT secret key — change this to a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Frontend URL for CORS (default Vite dev server)
FRONTEND_URL=http://localhost:5173

# ─── Job API Keys (optional) ────────────────────────────────────────────────
# Set JOB_PROVIDER to 'mock' (default), 'adzuna', or 'jooble'
JOB_PROVIDER=mock

# Adzuna (https://developer.adzuna.com) — free tier available
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Jooble (https://jooble.org/api/about)
JOOBLE_API_KEY=

# RapidAPI (for other job boards via RapidAPI)
RAPIDAPI_KEY=
